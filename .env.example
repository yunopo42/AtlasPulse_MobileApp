# AtlasPulse Supabase Yapılandırması
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mapbox Token (Vektör Haritalar için)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# RevenueCat Public API Key (Google Play Billing için)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_revenuecat_key
